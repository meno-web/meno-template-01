{
  "siteUrl": "https://example.com",
  "editor": {
    "theme": "light"
  },
  "breakpoints": {
    "tablet": {
      "breakpoint": 1024,
      "previewPoint": 880
    },
    "mobile": {
      "breakpoint": 540,
      "previewPoint": 375
    }
  },
  "fonts": [
    {
      "path": "/fonts/Inter-VariableFont_opsz,wght.woff2",
      "family": "Inter",
      "weight": 100,
      "weightMax": 900,
      "fontDisplay": "swap"
    },
    {
      "path": "/fonts/manrope-variable.woff2",
      "family": "Manrope",
      "weight": 200,
      "weightMax": 800
    },
    {
      "path": "/fonts/josefin-sans-variable.woff2",
      "family": "Josefin Sans",
      "weight": 100,
      "weightMax": 700
    },
    {
      "path": "/fonts/geist-variable.woff2",
      "family": "Geist",
      "weight": 100,
      "weightMax": 900
    },
    {
      "path": "/fonts/libre-franklin-variable.woff2",
      "family": "Libre Franklin",
      "weight": 100,
      "weightMax": 900
    },
    {
      "path": "/fonts/playfair-display-variable-1.woff2",
      "family": "Playfair Display",
      "weight": 400,
      "weightMax": 900
    },
    {
      "path": "/fonts/quicksand-variable.woff2",
      "family": "Quicksand",
      "weight": 300,
      "weightMax": 700
    },
    {
      "path": "/fonts/outfit-variable.woff2",
      "family": "Outfit",
      "weight": 100,
      "weightMax": 900
    }
  ],
  "responsiveScales": {
    "enabled": true,
    "baseReference": 16,
    "fontSize": {
      "tablet": 0.88,
      "mobile": 0.75
    },
    "padding": {
      "tablet": 0.75,
      "mobile": 0.5
    },
    "margin": {
      "tablet": 0.7,
      "mobile": 0.45
    },
    "gap": {
      "tablet": 0.65,
      "mobile": 0.4
    }
  },
  "prefetch": {
    "enabled": false
  },
  "icons": {
    "favicon": "/icons/icon-32.png",
    "appleTouchIcon": "/icons/icon-180.png"
  },
  "baseComponent": "Layout",
  "libraries": {
    "js": [
      {
        "url": "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
      }
    ]
  },
  "csp": {
    "scriptSrc": [
      "https://cdn.jsdelivr.net"
    ],
    "styleSrc": [
      "https://cdn.jsdelivr.net"
    ]
  }
}