{
  "siteUrl": "https://example.com",
  "editor": {
    "theme": "light"
  },
  "breakpoints": {
    "tablet": {
      "breakpoint": 1024,
      "previewPoint": 880
    },
    "mobile": {
      "breakpoint": 540,
      "previewPoint": 375
    }
  },
  "fonts": [
    {
      "path": "/fonts/Inter-VariableFont_opsz,wght.woff2",
      "family": "Inter",
      "weight": 100,
      "weightMax": 900,
      "fontDisplay": "swap"
    },
    {
      "path": "/fonts/figtree-variable.woff2",
      "family": "Figtree",
      "weight": 300,
      "weightMax": 900
    },
    {
      "path": "/fonts/barlow-400.woff2",
      "family": "Barlow",
      "weight": 400
    },
    {
      "path": "/fonts/barlow-500.woff2",
      "family": "Barlow",
      "weight": 500
    },
    {
      "path": "/fonts/barlow-600.woff2",
      "family": "Barlow",
      "weight": 600
    },
    {
      "path": "/fonts/barlow-700.woff2",
      "family": "Barlow",
      "weight": 700
    },
    {
      "path": "/fonts/bitter-variable.woff2",
      "family": "Bitter",
      "weight": 100,
      "weightMax": 900
    }
  ],
  "responsiveScales": {
    "enabled": true,
    "baseReference": 16,
    "fontSize": {
      "tablet": 0.88,
      "mobile": 0.75
    },
    "padding": {
      "tablet": 0.75,
      "mobile": 0.5
    },
    "margin": {
      "tablet": 0.7,
      "mobile": 0.45
    },
    "gap": {
      "tablet": 0.65,
      "mobile": 0.4
    }
  },
  "prefetch": {
    "enabled": false
  },
  "icons": {
    "favicon": "/icons/icon-32.png",
    "appleTouchIcon": "/icons/icon-180.png"
  },
  "baseComponent": "Layout"
}