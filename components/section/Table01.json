{
  "component": {
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Details"
      },
      "title": {
        "type": "rich-text",
        "default": "Developer-Friendly Details"
      },
      "text": {
        "type": "rich-text",
        "default": "Technical specifications and features at a glance."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "options": ["primary", "secondary"]
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "label": { "type": "string", "default": "Feature" },
          "value": { "type": "string", "default": "Description" }
        },
        "default": [
          { "label": "No runtime dependency", "value": "Generated pages are static HTML + CSS" },
          { "label": "Zero JavaScript required", "value": "Output works without JS (add it if you want)" },
          { "label": "Predictable output", "value": "Same JSON always produces same HTML" },
          { "label": "Component props", "value": "Pass data to components for flexible reuse" },
          { "label": "Tree structure", "value": "Nodes have path arrays for precise targeting" },
          { "label": "Zod validation", "value": "All schemas are validated at runtime" },
          { "label": "Extensible", "value": "Add custom components" }
        ]
      }
    },
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "props": {
                "text": "{{subtitle}}",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "size": "2",
                "tag": "2",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Spacer",
          "props": {
            "size": "48"
          }
        },
        {
          "type": "component",
          "component": "Table",
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{list}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "TableRow",
                  "props": {
                    "label": "{{item.label}}",
                    "value": "{{item.value}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
