{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "node",
          "tag": "div",
          "style": {
            "base": {
              "maxWidth": "700px",
              "margin": "0 auto",
              "position": "relative",
              "paddingLeft": "64px"
            },
            "tablet": {},
            "mobile": {
              "paddingLeft": "52px"
            }
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "position": "absolute",
                  "left": "15px",
                  "top": "8px",
                  "bottom": "72px",
                  "width": "2px",
                  "backgroundColor": "var(--border)"
                },
                "tablet": {},
                "mobile": {
                  "bottom": "106px"
                }
              }
            },
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "position": "relative",
                      "paddingBottom": "48px"
                    }
                  },
                  "attributes": {
                    "fade": "{{0.4+0.2*itemIndex}}"
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "position": "absolute",
                          "left": "-52px",
                          "top": "0",
                          "width": "32px",
                          "height": "32px",
                          "backgroundColor": "var(--text)",
                          "borderRadius": "50%",
                          "display": "flex",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "color": "#ffffff",
                          "fontWeight": "700",
                          "fontSize": "14px"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "children": "{{itemIndex}}"
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "5",
                        "tag": "3"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}",
                        "variant": "light"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "How It Works"
      },
      "title": {
        "type": "rich-text",
        "default": "Simple steps to get started"
      },
      "text": {
        "type": "rich-text",
        "default": "Follow these easy steps to begin your journey with us."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "title": {
            "type": "string",
            "default": "Step title"
          },
          "text": {
            "type": "string",
            "default": "Step description"
          }
        },
        "default": [
          {
            "title": "Sign up for free",
            "text": "Create your account in seconds. No credit card required to get started."
          },
          {
            "title": "Set up your project",
            "text": "Configure your workspace and invite your team members to collaborate."
          },
          {
            "title": "Customize your workflow",
            "text": "Tailor the platform to fit your specific needs and preferences."
          },
          {
            "title": "Launch and grow",
            "text": "Go live and start achieving your goals with our powerful tools."
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}