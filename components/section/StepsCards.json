{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "size": "2",
                "tag": "2",
                "align": "center",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "3",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "Card",
                  "props": {
                    "variant": "light"
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "StatNumber",
                      "props": {
                        "text": "{{item.value}}"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "3",
                        "tag": "3"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "How It Works"
      },
      "title": {
        "type": "rich-text",
        "default": "Simple steps to get started"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "1"
          },
          "title": {
            "type": "string",
            "default": "Step title"
          },
          "text": {
            "type": "string",
            "default": "Step description"
          }
        },
        "default": [
          {
            "value": "1",
            "title": "Step one",
            "text": "Short description of this step that previews how the card looks and reads in the editor."
          },
          {
            "value": "2",
            "title": "Step two",
            "text": "Short description of this step that previews how the card looks and reads in the editor."
          },
          {
            "value": "3",
            "title": "Step three",
            "text": "Short description of this step that previews how the card looks and reads in the editor."
          }
        ]
      }
    }
  }
}