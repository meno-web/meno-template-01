{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default",
        "cropped": "{{!cropped}}"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "360px",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Slider",
          "props": {
            "gap": 20,
            "autoplay": "{{autoplay}}",
            "loop": "{{loop}}",
            "columns": "3",
            "cropped": "{{cropped}}",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Card",
                  "style": {
                    "base": {
                      "backgroundColor": "var(--bg-100)",
                      "borderRadius": "12px",
                      "overflow": "hidden"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Image",
                      "props": {
                        "image": "{{item.image}}",
                        "aspectRatio": "16/9",
                        "height": "auto",
                        "width": "100%"
                      },
                      "style": {
                        "base": {
                          "width": "100%",
                          "height": "auto"
                        },
                        "tablet": {},
                        "mobile": {}
                      }
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "label": "Card Body",
                      "style": {
                        "base": {
                          "padding": "24px"
                        }
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Heading",
                          "props": {
                            "text": "{{item.title}}",
                            "size": "4"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Text",
                          "props": {
                            "size": "default",
                            "variant": "default",
                            "text": "{{item.text}}"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Features"
      },
      "title": {
        "type": "rich-text",
        "default": "Your section heading"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "image": {
            "type": "file",
            "default": "/images/placeholder-img.webp"
          },
          "title": {
            "type": "string",
            "default": "Card title"
          },
          "text": {
            "type": "rich-text"
          }
        },
        "default": [
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Card title",
            "text": "Short description of this item that previews how the slider looks and reads in the editor."
          }
        ]
      },
      "autoplay": {
        "type": "boolean",
        "default": false
      },
      "loop": {
        "type": "boolean",
        "default": true
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      },
      "cropped": {
        "type": "boolean",
        "default": false
      }
    }
  }
}