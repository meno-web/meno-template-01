{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "vertical": "top",
            "horizontal": "center"
          },
          "children": [
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "440px",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "450px",
                "isMarginBottom": true
              }
            },
            {
              "type": "component",
              "component": "ButtonList",
              "props": {
                "justify": "center"
              },
              "children": [
                {
                  "type": "component",
                  "component": "Button",
                  "props": {
                    "text": "{{buttonText}}",
                    "link": "{{buttonLink}}",
                    "variant": "primary"
                  }
                },
                {
                  "type": "component",
                  "component": "Button",
                  "props": {
                    "text": "{{secondaryButtonText}}",
                    "link": "{{secondaryButtonLink}}",
                    "variant": "secondary"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Ready to get started?"
      },
      "text": {
        "type": "rich-text",
        "default": "Join thousands of satisfied customers who have already transformed their business."
      },
      "buttonText": {
        "type": "string",
        "default": "Get started"
      },
      "buttonLink": {
        "type": "link",
        "default": "#"
      },
      "secondaryButtonText": {
        "type": "string",
        "default": "Learn more"
      },
      "secondaryButtonLink": {
        "type": "link",
        "default": "#"
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}