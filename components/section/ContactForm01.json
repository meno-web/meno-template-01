{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "maxWidth": "640",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "500px"
          },
          "children": [
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "size": "2",
                "tag": "2",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Form",
          "props": {
            "action": "/api/send-email",
            "method": "post",
            "submitHandler": "fetch",
            "successMessage": "Dziękujemy! Odpowiemy najszybciej jak to możliwe.",
            "errorMessage": "Coś poszło nie tak. Spróbuj ponownie."
          },
          "children": [
            {
              "type": "component",
              "component": "FormField",
              "children": [
                {
                  "type": "component",
                  "component": "Label",
                  "props": {
                    "text": "Imię i nazwisko"
                  }
                },
                {
                  "type": "component",
                  "component": "Input",
                  "props": {
                    "inputType": "text",
                    "name": "fullName",
                    "placeholder": "Wasze imię i nazwisko"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "FormField",
              "children": [
                {
                  "type": "component",
                  "component": "Label",
                  "props": {
                    "text": "Adres email"
                  }
                },
                {
                  "type": "component",
                  "component": "Input",
                  "props": {
                    "inputType": "email",
                    "name": "email",
                    "placeholder": "wasz@email.pl"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "FormField",
              "children": [
                {
                  "type": "component",
                  "component": "Label",
                  "props": {
                    "text": "Data wesela"
                  }
                },
                {
                  "type": "component",
                  "component": "Input",
                  "props": {
                    "inputType": "date",
                    "name": "weddingDate",
                    "placeholder": ""
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "FormField",
              "children": [
                {
                  "type": "component",
                  "component": "Label",
                  "props": {
                    "text": "Wiadomość"
                  }
                },
                {
                  "type": "component",
                  "component": "Textarea",
                  "props": {
                    "name": "message",
                    "placeholder": "Opowiedzcie nam o swoim weselu...",
                    "rows": "5"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "Submit",
              "props": {
                "text": "{{buttonText}}"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Get in touch"
      },
      "text": {
        "type": "rich-text",
        "default": "Have a question or want to learn more? Fill out the form below and we'll get back to you."
      },
      "theme": {
        "type": "select",
        "default": "secondary",
        "options": [
          "primary",
          "secondary"
        ]
      },
      "buttonText": {
        "type": "string",
        "default": "Send Message"
      }
    }
  }
}