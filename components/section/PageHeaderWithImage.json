{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "primary",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "vertical": "top",
            "horizontal": "center"
          },
          "children": [
            {
              "type": "component",
              "component": "Image",
              "props": {
                "image": "{{image}}",
                "height": "400px"
              }
            },
            {
              "type": "component",
              "component": "Spacer",
              "props": {
                "size": "64"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "480px",
                "align": "center",
                "size": "1",
                "tag": "1",
                "variant": "default"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "580px",
                "isMarginBottom": true
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Page title"
      },
      "text": {
        "type": "rich-text",
        "default": "A brief description of this page and what visitors can expect to find here."
      },
      "image": {
        "type": "file",
        "default": "/images/placeholder.webp",
        "accept": "image/*"
      }
    }
  }
}