{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": "{{isCenter}}",
            "maxWidth": ""
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "fade": "0",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                }
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "640px",
                "fade": "0.2",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "fade": "0.4",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "maxWidth": "580px"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "1",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Stat Row",
                  "style": {
                    "base": {
                      "display": "flex",
                      "alignItems": "center",
                      "gap": "32px",
                      "padding": "32px 0",
                      "borderBottom": "1px solid var(--border)"
                    },
                    "mobile": {
                      "flexDirection": "column",
                      "alignItems": "flex-start",
                      "gap": "16px"
                    }
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "label": "Value Wrap",
                      "style": {
                        "base": {
                          "minWidth": "180px"
                        },
                        "mobile": {
                          "minWidth": "auto"
                        }
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Heading",
                          "props": {
                            "text": "{{item.value}}",
                            "size": "2",
                            "tag": "3",
                            "color": "primary",
                            "isMb0": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "label": "Content",
                      "style": {
                        "base": {
                          "display": "flex",
                          "flexDirection": "column",
                          "gap": "8px"
                        }
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Heading",
                          "props": {
                            "text": "{{item.label}}",
                            "size": "4",
                            "tag": "4"
                          }
                        },
                        {
                          "type": "component",
                          "component": "Text",
                          "if": "{{item.description}}",
                          "props": {
                            "text": "{{item.description}}",
                            "color": "secondary",
                            "maxWidth": "500px"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Results"
      },
      "title": {
        "type": "rich-text",
        "default": "Your section heading"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "isCenter": {
        "type": "boolean",
        "default": false
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "100+"
          },
          "label": {
            "type": "string",
            "default": "Label"
          },
          "description": {
            "type": "string",
            "default": ""
          }
        },
        "default": [
          {
            "value": "2.5M+",
            "label": "Stat label",
            "description": "Short description of this statistic that previews how the row looks."
          },
          {
            "value": "99.9%",
            "label": "Stat label",
            "description": "Short description of this statistic that previews how the row looks."
          },
          {
            "value": "< 50ms",
            "label": "Stat label",
            "description": "Short description of this statistic that previews how the row looks."
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}