{
  "component": {
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Details"
      },
      "title": {
        "type": "rich-text",
        "default": "Your specifications heading"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "label": {
            "type": "string",
            "default": "Feature"
          },
          "value": {
            "type": "string",
            "default": "Description"
          }
        },
        "default": [
          {
            "label": "Specification one",
            "value": "Value or description"
          },
          {
            "label": "Specification two",
            "value": "Value or description"
          },
          {
            "label": "Specification three",
            "value": "Value or description"
          },
          {
            "label": "Specification four",
            "value": "Value or description"
          },
          {
            "label": "Specification five",
            "value": "Value or description"
          },
          {
            "label": "Specification six",
            "value": "Value or description"
          },
          {
            "label": "Specification seven",
            "value": "Value or description"
          }
        ]
      }
    },
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "size": "2",
                "tag": "2",
                "align": "center",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Spacer",
          "props": {
            "size": "48"
          }
        },
        {
          "type": "component",
          "component": "Table",
          "props": {
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "TableRow",
                  "props": {
                    "label": "{{item.label}}",
                    "value": "{{item.value}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
