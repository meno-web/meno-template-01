{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "450px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "isMarginBottom": true,
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "3",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "Card",
                  "children": [
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "display": "flex",
                          "alignItems": "center",
                          "gap": "12px",
                          "marginTop": "24px"
                        }
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Avatar",
                          "props": {
                            "image": "{{item.image}}",
                            "alt": "{{item.title}}",
                            "size": "large"
                          }
                        },
                        {
                          "type": "node",
                          "tag": "div",
                          "children": [
                            {
                              "type": "component",
                              "component": "Heading",
                              "props": {
                                "text": "{{item.title}}",
                                "size": "6",
                                "tag": "0"
                              }
                            },
                            {
                              "type": "component",
                              "component": "Text",
                              "props": {
                                "text": "{{item.label}}",
                                "variant": "light",
                                "size": "small"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Testimonials"
      },
      "title": {
        "type": "rich-text",
        "default": "What people are saying"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "text": {
            "type": "rich-text",
            "default": "\"A short testimonial quote goes here about a positive experience.\""
          },
          "image": {
            "type": "file",
            "default": "/images/placeholder-img.webp"
          },
          "title": {
            "type": "string",
            "default": "Name"
          },
          "label": {
            "type": "string",
            "default": "Job title, Company Name"
          }
        },
        "default": [
          {
            "text": "\"A short testimonial quote goes here about a positive experience with your brand or offering.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Jane Doe",
            "label": "Job title, Company Name"
          },
          {
            "text": "\"A short testimonial quote goes here about a positive experience with your brand or offering.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Jane Doe",
            "label": "Job title, Company Name"
          },
          {
            "text": "\"A short testimonial quote goes here about a positive experience with your brand or offering.\"",
            "image": "/images/placeholder-img.webp",
            "title": "Jane Doe",
            "label": "Job title, Company Name"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}
