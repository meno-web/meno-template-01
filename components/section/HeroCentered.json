{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "backgroundImage": "{{image}}"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "horizontal": "center"
          },
          "children": [
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "tag": "1",
                "align": "center",
                "size": "1"
              },
              "tag": "4"
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "640px",
                "variant": "light"
              }
            },
            {
              "type": "component",
              "component": "ButtonList",
              "if": "{{buttonText}}",
              "children": [
                {
                  "type": "component",
                  "component": "Button",
                  "props": {
                    "text": "{{buttonText}}",
                    "link": "{{buttonLink}}"
                  }
                },
                {
                  "type": "component",
                  "component": "Button",
                  "if": "{{secondaryButtonText}}",
                  "props": {
                    "text": "{{secondaryButtonText}}",
                    "link": "{{secondaryButtonLink}}",
                    "variant": "secondary"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Build something amazing"
      },
      "text": {
        "type": "rich-text",
        "default": "Create beautiful websites and applications with our powerful platform. Get started in minutes."
      },
      "image": {
        "type": "file",
        "default": "/images/placeholder-img.webp",
        "accept": "image/*"
      },
      "buttonText": {
        "type": "string",
        "default": "Get started"
      },
      "buttonLink": {
        "type": "link",
        "default": "#"
      },
      "secondaryButtonText": {
        "type": "string",
        "default": "Learn more"
      },
      "secondaryButtonLink": {
        "type": "link",
        "default": "#"
      },
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      }
    }
  }
}