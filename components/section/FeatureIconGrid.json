{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "640px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "400px",
                "variant": "default"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "{{columns}}"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Card",
                  "style": {
                    "base": {
                      "display": "flex",
                      "flexDirection": "column",
                      "alignItems": "center",
                      "textAlign": "center",
                      "padding": "32px 24px",
                      "background": "var(--bg-100)",
                      "borderRadius": "12px"
                    },
                    "tablet": {},
                    "mobile": {}
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "div",
                      "label": "Icon Wrap",
                      "style": {
                        "base": {
                          "width": "64px",
                          "height": "64px",
                          "backgroundColor": "var(--bg-200)",
                          "borderRadius": "16px",
                          "display": "flex",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "marginBottom": "20px"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "children": [
                        {
                          "type": "component",
                          "component": "Icon",
                          "props": {
                            "size": 24,
                            "icon": "{{item.icon}}"
                          }
                        }
                      ]
                    },
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "5",
                        "tag": "3",
                        "align": "center"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}",
                        "size": "small",
                        "variant": "light",
                        "align": "center"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Features"
      },
      "title": {
        "type": "rich-text",
        "default": "Why choose us"
      },
      "text": {
        "type": "rich-text",
        "default": "Discover the key features that make our platform stand out from the rest."
      },
      "columns": {
        "type": "select",
        "default": "3",
        "options": [
          "2",
          "3",
          "4",
          "6"
        ]
      },
      "theme": {
        "type": "select",
        "default": "light",
        "enumName": "theme"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "icon": {
            "type": "select",
            "default": "zap",
            "enumName": "icons"
          },
          "title": {
            "type": "string",
            "default": "Feature"
          },
          "text": {
            "type": "rich-text"
          }
        },
        "default": [
          {
            "icon": "zap",
            "title": "Fast Performance",
            "text": "Lightning-fast load times ensure your users never have to wait."
          },
          {
            "icon": "shield",
            "title": "Secure by Design",
            "text": "Enterprise-grade security protects your data at every level."
          },
          {
            "icon": "settings",
            "title": "Easy Integration",
            "text": "Connect with your favorite tools in minutes, not hours."
          },
          {
            "icon": "headphones",
            "title": "24/7 Support",
            "text": "Our team is always here to help whenever you need us."
          },
          {
            "icon": "trending-up",
            "title": "Scalable",
            "text": "Grow without limits as your business expands."
          },
          {
            "icon": "bar-chart-3",
            "title": "Analytics",
            "text": "Gain insights with powerful built-in analytics tools."
          }
        ]
      }
    }
  }
}