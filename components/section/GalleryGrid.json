{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "3",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "position": "relative",
                      "borderRadius": "12px",
                      "overflow": "hidden",
                      "aspectRatio": "4/3"
                    }
                  },
                  "interactiveStyles": [
                    {
                      "prefix": "",
                      "postfix": ":hover [data-el='overlay']",
                      "style": {
                        "base": {
                          "opacity": "1"
                        }
                      }
                    }
                  ],
                  "children": [
                    {
                      "type": "node",
                      "tag": "img",
                      "style": {
                        "base": {
                          "width": "100%",
                          "height": "100%",
                          "objectFit": "cover",
                          "transition": "transform 0.3s ease"
                        }
                      },
                      "attributes": {
                        "src": "{{item.image}}",
                        "alt": "{{item.title}}"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "position": "absolute",
                          "bottom": "0",
                          "left": "0",
                          "right": "0",
                          "padding": "24px",
                          "background": "linear-gradient(transparent, rgba(0,0,0,0.7))",
                          "opacity": "0",
                          "transition": "opacity 0.3s ease"
                        }
                      },
                      "attributes": {
                        "data-el": "overlay"
                      },
                      "children": [
                        {
                          "type": "node",
                          "tag": "p",
                          "style": {
                            "base": {
                              "color": "#ffffff",
                              "fontSize": "14px",
                              "margin": "0"
                            }
                          },
                          "children": "{{item.text}}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Gallery"
      },
      "title": {
        "type": "rich-text",
        "default": "Your section heading"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "image": {
            "type": "file",
            "default": "/images/placeholder-img.webp"
          },
          "title": {
            "type": "string",
            "default": "Project"
          },
          "text": {
            "type": "string",
            "default": "Project description"
          }
        },
        "default": [
          {
            "image": "/images/placeholder-img.webp",
            "title": "Item one",
            "text": "Short caption for this gallery item"
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Item two",
            "text": "Short caption for this gallery item"
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Item three",
            "text": "Short caption for this gallery item"
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Item four",
            "text": "Short caption for this gallery item"
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Item five",
            "text": "Short caption for this gallery item"
          },
          {
            "image": "/images/placeholder-img.webp",
            "title": "Item six",
            "text": "Short caption for this gallery item"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}
