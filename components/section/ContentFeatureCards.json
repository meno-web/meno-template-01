{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "spaceTop": "default",
        "spaceBottom": "default",
        "theme": "{{theme}}"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "450px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "align": "center",
                "fade": "0"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2",
                "fade": "0.2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "isMarginBottom": true,
                "fade": "0.4"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "Grid",
          "props": {
            "columns": "2",
            "gap": "24",
            "fade": "0.4"
          },
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "Card",
                  "props": {},
                  "children": [
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "3",
                        "tag": "3"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.text}}",
                        "isMarginBottom": true
                      }
                    },
                    {
                      "type": "component",
                      "component": "Spacer",
                      "props": {
                        "size": "24"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "fontSize": "15px",
                          "lineHeight": "1.8",
                          "color": "var(--text-secondary)"
                        }
                      },
                      "children": "{{item.features}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Features"
      },
      "title": {
        "type": "rich-text",
        "default": "Your section heading"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "title": {
            "type": "string",
            "default": "Feature Title"
          },
          "text": {
            "type": "rich-text",
            "default": "Feature description goes here."
          },
          "features": {
            "type": "rich-text",
            "default": "Feature 1\nFeature 2\nFeature 3\nFeature 4"
          }
        },
        "default": [
          {
            "title": "Feature title",
            "text": "Short description of this item that previews how the card looks and reads in the editor.",
            "features": "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
          },
          {
            "title": "Feature title",
            "text": "Short description of this item that previews how the card looks and reads in the editor.",
            "features": "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
          },
          {
            "title": "Feature title",
            "text": "Short description of this item that previews how the card looks and reads in the editor.",
            "features": "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
          },
          {
            "title": "Feature title",
            "text": "Short description of this item that previews how the card looks and reads in the editor.",
            "features": "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
          }
        ]
      }
    }
  }
}
