{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "spaceTop": "default",
        "spaceBottom": "default",
        "theme": "{{theme}}",
        "maxWidth": "1280"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": false,
            "maxWidth": ""
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "fade": "0",
                "align": "left"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "size": "2",
                "tag": "2",
                "fade": "0.2",
                "align": "left"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "fade": "0.4",
                "align": "left"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "FaqList",
          "children": [
            {
              "type": "list",
              "sourceType": "prop",
              "source": "{{items}}",
              "itemAs": "item",
              "children": [
                {
                  "type": "component",
                  "component": "FaqItem",
                  "props": {
                    "question": "{{item.title}}",
                    "answer": "{{item.text}}",
                    "isOpen": "{{item.isOpen}}",
                    "fade": "{{0.4+itemIndex*0.2}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "FAQ"
      },
      "title": {
        "type": "rich-text",
        "default": "Frequently asked questions"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      },
      "items": {
        "type": "list",
        "itemSchema": {
          "title": {
            "type": "string",
            "default": "Question?"
          },
          "text": {
            "type": "rich-text",
            "default": "Answer goes here."
          },
          "isOpen": {
            "type": "boolean",
            "default": false
          }
        },
        "default": [
          {
            "title": "Your first question?",
            "text": "Short answer that previews how this accordion item looks and reads in the editor. Replace with your own content.",
            "isOpen": true
          },
          {
            "title": "Your second question?",
            "text": "Short answer that previews how this accordion item looks and reads in the editor. Replace with your own content."
          },
          {
            "title": "Your third question?",
            "text": "Short answer that previews how this accordion item looks and reads in the editor. Replace with your own content."
          },
          {
            "title": "Your fourth question?",
            "text": "Short answer that previews how this accordion item looks and reads in the editor. Replace with your own content."
          }
        ]
      }
    }
  }
}
