{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "500px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "if": "{{subtitle}}",
              "props": {
                "text": "{{subtitle}}",
                "fade": "0",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "fade": "0.2",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "if": "{{text}}",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "fade": "0.4",
                "align": "center",
                "maxWidth": "",
                "isMarginBottom": true
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "SplitContent",
          "children": [
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{leftText}}",
                "fade": "0.4",
                "size": "default",
                "align": "left",
                "maxWidth": "100%"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{rightText}}",
                "fade": "0.6",
                "size": "default",
                "align": "left",
                "maxWidth": "100%"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Features"
      },
      "title": {
        "type": "rich-text",
        "default": "Your section heading"
      },
      "text": {
        "type": "rich-text",
        "default": "Short supporting description that previews how this section looks and reads in the editor."
      },
      "leftText": {
        "type": "rich-text",
        "default": "Short supporting paragraph that previews how this column looks in the editor. Replace this placeholder copy with your own message that speaks to your audience and supports the heading above."
      },
      "rightText": {
        "type": "rich-text",
        "default": "Short supporting paragraph that previews how this column looks in the editor. Replace this placeholder copy with your own message that continues the narrative from the left column."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}