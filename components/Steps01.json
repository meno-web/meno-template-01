{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "props": {
                "text": "{{subtitle}}",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "size": "2",
                "tag": "2",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "ListGrid",
          "props": {
            "list": "{{list}}",
            "columns": "3"
          },
          "children": [
            {
              "type": "component",
              "component": "Card",
              "props": {
                "variant": "light"
              },
              "children": [
                {
                  "type": "component",
                  "component": "StatNumber",
                  "props": {
                    "text": "{{item.value}}"
                  }
                },
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{item.title}}",
                    "size": "3",
                    "tag": "3"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{item.text}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "How It Works"
      },
      "title": {
        "type": "rich-text",
        "default": "Simple steps to get started"
      },
      "text": {
        "type": "rich-text",
        "default": "Follow these easy steps to begin your journey with us."
      },
      "theme": {
        "type": "select",
        "default": "secondary",
        "options": [
          "primary",
          "secondary"
        ]
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "1"
          },
          "title": {
            "type": "string",
            "default": "Step title"
          },
          "text": {
            "type": "string",
            "default": "Step description"
          }
        },
        "default": [
          {
            "value": "1",
            "title": "Design",
            "text": "Use the visual editor to build your page layout. Add elements, style them, and preview in real-time."
          },
          {
            "value": "2",
            "title": "Commit",
            "text": "Your work saves as JSON files in your Git repository. Review diffs, branch for experiments, merge when ready."
          },
          {
            "value": "3",
            "title": "Deploy",
            "text": "Deploy to Vercel, Netlify, GitHub Pages, or your own infrastructure using meno-core package to build static HTML"
          }
        ]
      }
    }
  }
}