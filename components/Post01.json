{
  "component": {
    "interface": {},
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "primary"
      },
      "children": [
        {
          "type": "node",
          "tag": "article",
          "style": {
            "base": {
              "maxWidth": "720px",
              "margin": "0 auto"
            }
          },
          "children": [
            {
              "type": "node",
              "tag": "header",
              "style": {
                "base": {
                  "marginBottom": "32px"
                }
              },
              "children": [
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{cms.title}}",
                    "size": "1",
                    "tag": "1"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{cms.publishedAt}}",
                    "size": "small"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "Spacer",
              "props": {
                "size": "32"
              }
            },
            {
              "type": "component",
              "component": "RichText"
            }
          ]
        }
      ]
    }
  }
}