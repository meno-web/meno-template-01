{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "spaceTop": "default",
        "spaceBottom": "default",
        "theme": "{{theme}}"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "450px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "props": {
                "text": "{{subtitle}}",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "",
                "isMarginBottom": true
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "ListGrid",
          "props": {
            "list": "{{list}}"
          },
          "children": [
            {
              "type": "component",
              "component": "Card",
              "props": {},
              "children": [
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{item.title}}",
                    "size": "3",
                    "tag": "3"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{item.text}}",
                    "isMarginBottom": true
                  }
                },
                {
                  "type": "component",
                  "component": "Spacer",
                  "props": {
                    "size": "24"
                  }
                },
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "fontSize": "15px",
                      "lineHeight": "1.8",
                      "color": "var(--text-secondary)"
                    }
                  },
                  "children": "{{item.features}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Features"
      },
      "title": {
        "type": "rich-text",
        "default": "Learn more about our approach"
      },
      "text": {
        "type": "rich-text",
        "default": "We believe in transparency and sharing our process with you."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "options": [
          "primary",
          "secondary"
        ]
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "title": {
            "type": "string",
            "default": "Feature Title"
          },
          "text": {
            "type": "rich-text",
            "default": "Feature description goes here."
          },
          "features": {
            "type": "rich-text",
            "default": "Feature 1\nFeature 2\nFeature 3\nFeature 4"
          }
        },
        "default": [
          {
            "title": "SSO & Team Management",
            "text": "Meno authenticates through GitHub OAuth. If your org has GitHub Enterprise with SAML SSO, your team signs in the same way they access your repos—no separate identity setup needed.",
            "features": "SSO via GitHub OAuth—inherits your org's identity provider\nRole-based access through GitHub org permissions\nTeam workspaces with granular permissions\nAudit logs via GitHub—every action tracked in your repos"
          },
          {
            "title": "Self-Hosting & Security",
            "text": "Your pages, components, and assets live in Git repositories under your GitHub org. Meno never stores your content—GitHub does.",
            "features": "Deploy on your own infrastructure\nAir-gapped environment support\nData stored in your GitHub repos, not Meno servers\nEnd-to-end encryption"
          },
          {
            "title": "Priority Support",
            "text": "Your team gets the help they need, when they need it.",
            "features": "Dedicated support channel for your organization\n24-hour response SLA\nHands-on onboarding and training\nDirect access to our engineering team for complex issues"
          },
          {
            "title": "Custom Integrations",
            "text": "Make Meno fit your workflow, not the other way around.",
            "features": "Full API access\nWebhooks for automation\nCI/CD pipeline integration\nWhite-label options available"
          }
        ]
      }
    }
  }
}