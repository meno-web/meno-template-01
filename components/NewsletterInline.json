{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "Stack",
          "props": {
            "vertical": "top",
            "horizontal": "center"
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "maxWidth": "600px",
                  "textAlign": "center"
                }
              },
              "children": [
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{title}}",
                    "maxWidth": "",
                    "align": "center",
                    "size": "2",
                    "tag": "2"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{text}}",
                    "size": "large",
                    "align": "center",
                    "maxWidth": "",
                    "isMarginBottom": true
                  }
                },
                {
                  "type": "node",
                  "tag": "form",
                  "style": {
                    "base": {
                      "display": "flex",
                      "gap": "12px",
                      "justifyContent": "center",
                      "marginBottom": "16px"
                    },
                    "mobile": {
                      "flexDirection": "column"
                    }
                  },
                  "children": [
                    {
                      "type": "node",
                      "tag": "input",
                      "style": {
                        "base": {
                          "flex": "1",
                          "minWidth": "280px",
                          "padding": "14px 20px",
                          "fontSize": "16px",
                          "border": "1px solid var(--border)",
                          "borderRadius": "8px",
                          "backgroundColor": "var(--bg)",
                          "color": "var(--text)",
                          "outline": "none",
                          "transition": "border-color 0.2s ease"
                        },
                        "mobile": {
                          "minWidth": "100%"
                        }
                      },
                      "interactiveStyles": [
                        {
                          "prefix": "",
                          "postfix": ":focus",
                          "style": {
                            "base": {
                              "borderColor": "var(--primary)"
                            }
                          }
                        }
                      ],
                      "attributes": {
                        "type": "email",
                        "placeholder": "{{placeholderText}}",
                        "required": "true"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "button",
                      "style": {
                        "base": {
                          "padding": "14px 32px",
                          "backgroundColor": "var(--text)",
                          "color": "var(--bg)",
                          "border": "none",
                          "borderRadius": "8px",
                          "fontSize": "var(--b-fs)",
                          "fontWeight": "var(--b-fw)",
                          "cursor": "pointer",
                          "transition": "opacity 0.2s ease",
                          "whiteSpace": "nowrap"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "interactiveStyles": [
                        {
                          "prefix": "",
                          "postfix": ":hover",
                          "style": {
                            "base": {
                              "opacity": "0.9"
                            }
                          }
                        }
                      ],
                      "attributes": {
                        "type": "submit"
                      },
                      "children": "{{buttonText}}"
                    }
                  ]
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{privacyText}}",
                    "size": "small",
                    "variant": "light",
                    "align": "center"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "Subscribe to our newsletter"
      },
      "text": {
        "type": "rich-text",
        "default": "Get the latest updates, articles, and resources delivered straight to your inbox."
      },
      "placeholderText": {
        "type": "string",
        "default": "Enter your email"
      },
      "buttonText": {
        "type": "string",
        "default": "Subscribe"
      },
      "privacyText": {
        "type": "string",
        "default": "We respect your privacy. Unsubscribe at any time."
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "enumName": "theme"
      }
    }
  }
}