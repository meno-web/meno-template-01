{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "text": "Diffable output — Review AI changes with standard Git diffs",
        "theme": "primary"
      },
      "children": [
        {
          "type": "component",
          "component": "SplitContent",
          "children": [
            {
              "type": "node",
              "tag": "div",
              "children": [
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{title}}",
                    "size": "2",
                    "tag": "2",
                    "align": "left"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{text}}"
                  }
                },
                {
                  "type": "component",
                  "component": "Spacer",
                  "props": {
                    "size": "24"
                  }
                },
                {
                  "type": "component",
                  "component": "BulletList",
                  "children": [
                    {
                      "type": "list",
                      "sourceType": "prop",
                      "source": "{{list}}",
                      "style": {
                        "base": {
                          "display": "flex",
                          "flexDirection": "column",
                          "gap": "8px"
                        },
                        "tablet": {},
                        "mobile": {}
                      },
                      "itemAs": "item",
                      "children": [
                        {
                          "type": "component",
                          "component": "BulletItem",
                          "props": {
                            "text": "{{item.text}}"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "display": "flex",
                  "alignItems": "flex-start"
                },
                "tablet": {},
                "mobile": {}
              },
              "children": [
                {
                  "type": "component",
                  "component": "Image",
                  "props": {
                    "image": "{{image}}",
                    "objectFit": "contain",
                    "height": "auto",
                    "border": true,
                    "rounded": "large"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "title": {
        "type": "rich-text",
        "default": "A visual editor that doesn't get in your way."
      },
      "text": {
        "type": "rich-text",
        "default": "Build pages and components visually with a real-time preview. No generated code spaghetti—just structured JSON that compiles to static HTML."
      },
      "image": {
        "type": "file",
        "default": "/images/Screenshot-2026-01-13-at-15.48.27.webp"
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "text": {
            "type": "string",
            "default": "List item"
          }
        },
        "default": [
          {
            "text": "Drag-and-drop canvas — Add, move, and nest elements with a click"
          },
          {
            "text": "Real-time preview — See exactly what you're building as you build it"
          },
          {
            "text": "Component library — Reusable components with props and variants"
          }
        ]
      }
    }
  }
}