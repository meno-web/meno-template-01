{
  "component": {
    "interface": {
      "justify": {
        "type": "select",
        "options": ["center", "flex-start", "flex-end", "space-between"],
        "default": "center"
      }
    },
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "row",
          "gap": "16px",
          "justifyContent": {
            "_mapping": true,
            "prop": "justify",
            "values": {
              "center": "center",
              "flex-start": "flex-start",
              "flex-end": "flex-end",
              "space-between": "space-between"
            }
          }
        },
        "mobile": {
          "flexDirection": "column",
          "alignItems": "center"
        }
      },
      "children": [{ "type": "slot" }]
    }
  }
}
