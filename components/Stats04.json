{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": "{{isCenter}}",
            "maxWidth": ""
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "props": {
                "text": "{{subtitle}}",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                }
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "640px",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": {
                  "_mapping": true,
                  "prop": "isCenter",
                  "values": {
                    "default": "left",
                    "true": "center",
                    "false": "left"
                  }
                },
                "maxWidth": "580px"
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "ListGrid",
          "props": {
            "list": "{{list}}",
            "columns": "1"
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "label": "Stat Row",
              "style": {
                "base": {
                  "display": "flex",
                  "alignItems": "center",
                  "gap": "32px",
                  "padding": "32px 0",
                  "borderBottom": "1px solid var(--border)"
                },
                "mobile": {
                  "flexDirection": "column",
                  "alignItems": "flex-start",
                  "gap": "16px"
                }
              },
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Value Wrap",
                  "style": {
                    "base": {
                      "minWidth": "180px"
                    },
                    "mobile": {
                      "minWidth": "auto"
                    }
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.value}}",
                        "size": "display",
                        "tag": "3",
                        "color": "primary"
                      }
                    }
                  ]
                },
                {
                  "type": "node",
                  "tag": "div",
                  "label": "Content",
                  "style": {
                    "base": {
                      "display": "flex",
                      "flexDirection": "column",
                      "gap": "8px"
                    }
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.label}}",
                        "size": "4",
                        "tag": "4"
                      }
                    },
                    {
                      "type": "component",
                      "component": "Text",
                      "props": {
                        "text": "{{item.description}}",
                        "color": "secondary",
                        "maxWidth": "500px"
                      },
                      "showIf": "{{item.description}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Results"
      },
      "title": {
        "type": "rich-text",
        "default": "The impact we've made"
      },
      "text": {
        "type": "rich-text",
        "default": "Real numbers that showcase our commitment to excellence."
      },
      "isCenter": {
        "type": "boolean",
        "default": false
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "100+"
          },
          "label": {
            "type": "string",
            "default": "Label"
          },
          "description": {
            "type": "string",
            "default": ""
          }
        },
        "default": [
          {
            "value": "2.5M+",
            "label": "Users Worldwide",
            "description": "Active users across 120+ countries trust our platform daily"
          },
          {
            "value": "99.9%",
            "label": "Uptime Guarantee",
            "description": "Enterprise-grade reliability you can count on"
          },
          {
            "value": "< 50ms",
            "label": "Response Time",
            "description": "Lightning-fast performance for seamless experiences"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "options": [
          "primary",
          "secondary"
        ]
      }
    }
  }
}
