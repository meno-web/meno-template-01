{
  "component": {
    "structure": {
      "type": "list",
      "sourceType": "prop",
      "source": "{{list}}",
      "style": {
        "base": {
          "display": "grid",
          "gridTemplateColumns": "repeat({{columns}}, 3fr)",
          "gap": "20px"
        },
        "tablet": {
          "gridTemplateColumns": "repeat(2, 1fr)"
        },
        "mobile": {
          "gridTemplateColumns": "repeat(1, 1fr)"
        }
      },
      "itemAs": "item",
      "children": [
        {
          "type": "slot"
        }
      ]
    },
    "interface": {
      "list": {
        "type": "list",
        "itemSchema": {},
        "default": []
      },
      "columns": {
        "type": "select",
        "default": 2,
        "options": [
          "2",
          "3",
          "4",
          "5"
        ]
      }
    }
  }
}