{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "isCenter": true,
            "maxWidth": "600px"
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "props": {
                "text": "{{subtitle}}",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": ""
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "ListGrid",
          "props": {
            "list": "{{list}}",
            "columns": "3"
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "backgroundColor": "var(--surface)",
                  "borderRadius": "16px",
                  "padding": "32px",
                  "border": "1px solid var(--border-light)",
                  "display": "flex",
                  "flexDirection": "column"
                }
              },
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "marginBottom": "24px"
                    }
                  },
                  "children": [
                    {
                      "type": "component",
                      "component": "Heading",
                      "props": {
                        "text": "{{item.title}}",
                        "size": "5",
                        "tag": "3"
                      }
                    },
                    {
                      "type": "node",
                      "tag": "div",
                      "style": {
                        "base": {
                          "display": "flex",
                          "alignItems": "baseline",
                          "gap": "4px"
                        }
                      },
                      "children": [
                        {
                          "type": "node",
                          "tag": "span",
                          "style": {
                            "base": {
                              "fontSize": "48px",
                              "fontWeight": "700",
                              "color": "var(--text)"
                            }
                          },
                          "children": "{{item.value}}"
                        },
                        {
                          "type": "node",
                          "tag": "span",
                          "style": {
                            "base": {
                              "fontSize": "16px",
                              "color": "var(--text-secondary)"
                            }
                          },
                          "children": "{{item.label}}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "flex": "1",
                      "marginBottom": "32px",
                      "fontSize": "15px",
                      "lineHeight": "1.8",
                      "color": "var(--text-secondary)"
                    }
                  },
                  "children": "{{item.text}}"
                },
                {
                  "type": "node",
                  "tag": "a",
                  "style": {
                    "base": {
                      "display": "block",
                      "textAlign": "center",
                      "padding": "14px 24px",
                      "backgroundColor": "var(--primary)",
                      "color": "#ffffff",
                      "borderRadius": "8px",
                      "fontSize": "16px",
                      "fontWeight": "600",
                      "textDecoration": "none",
                      "transition": "all 0.2s ease"
                    }
                  },
                  "interactiveStyles": [
                    {
                      "prefix": "",
                      "postfix": ":hover",
                      "style": {
                        "base": {
                          "opacity": "0.9"
                        }
                      }
                    }
                  ],
                  "attributes": {
                    "href": "{{item.link}}"
                  },
                  "children": "{{item.buttonText}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Pricing"
      },
      "title": {
        "type": "rich-text",
        "default": "Simple, transparent pricing"
      },
      "text": {
        "type": "rich-text",
        "default": "Choose the plan that works best for you. No hidden fees."
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "title": {
            "type": "string",
            "default": "Plan Name"
          },
          "value": {
            "type": "string",
            "default": "$9"
          },
          "label": {
            "type": "string",
            "default": "/month"
          },
          "text": {
            "type": "rich-text",
            "default": "Feature 1\nFeature 2\nFeature 3"
          },
          "buttonText": {
            "type": "string",
            "default": "Get started"
          },
          "link": {
            "type": "link",
            "default": "#"
          }
        },
        "default": [
          {
            "title": "Starter",
            "value": "$9",
            "label": "/month",
            "text": "Up to 5 projects\nBasic analytics\nEmail support\n1 GB storage",
            "buttonText": "Get started",
            "link": "#"
          },
          {
            "title": "Professional",
            "value": "$29",
            "label": "/month",
            "text": "Unlimited projects\nAdvanced analytics\nPriority support\n10 GB storage",
            "buttonText": "Get started",
            "link": "#"
          },
          {
            "title": "Enterprise",
            "value": "$99",
            "label": "/month",
            "text": "Everything in Pro\nCustom integrations\nDedicated support\nUnlimited storage",
            "buttonText": "Contact sales",
            "link": "#"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "options": [
          "primary",
          "secondary"
        ]
      }
    }
  }
}