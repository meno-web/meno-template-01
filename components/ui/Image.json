{
  "component": {
    "structure": {
      "type": "node",
      "tag": "img",
      "style": {
        "base": {
          "display": "block",
          "objectFit": "{{objectFit}}",
          "borderColor": "var(--border)",
          "aspectRatio": "{{aspectRatio}}"
        },
        "tablet": {},
        "mobile": {}
      },
      "attributes": {
        "src": "{{image}}",
        "alt": "{{alt}}",
        "loading": "{{loading}}",
        "fetchpriority": "{{fetchpriority}}",
        "sizes": "{{sizes}}",
        "fade": "{{fade}}"
      },
      "children": []
    },
    "interface": {
      "alt": {
        "type": "string",
        "default": ""
      },
      "loading": {
        "type": "select",
        "default": "lazy",
        "options": [
          "lazy",
          "eager"
        ]
      },
      "objectFit": {
        "type": "select",
        "default": "cover",
        "options": [
          "cover",
          "contain",
          "fill",
          "scale-down"
        ]
      },
      "image": {
        "type": "file",
        "default": "/images/placeholder-img.webp",
        "accept": "image/*"
      },
      "fetchpriority": {
        "type": "select",
        "default": "auto",
        "options": [
          "auto",
          "high",
          "low"
        ]
      },
      "sizes": {
        "type": "string",
        "default": ""
      },
      "aspectRatio": {
        "type": "string",
        "default": ""
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    },
    "acceptsStyles": true
  }
}