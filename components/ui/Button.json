{
  "component": {
    "structure": {
      "type": "link",
      "href": {
        "_mapping": true,
        "prop": "link"
      },
      "label": "button",
      "style": {
        "base": {
          "fontSize": "var(--b-fs)",
          "cursor": "pointer",
          "transition": "all 0.2s",
          "display": "flex",
          "gap": "var(--b-g)",
          "alignItems": "center",
          "padding": "var(--b-p)",
          "border": "1px solid",
          "borderColor": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "primary": "var(--text)",
              "secondary": "var(--border)"
            }
          },
          "backgroundColor": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "primary": "var(--text)",
              "secondary": "var(--bg)"
            }
          },
          "color": {
            "_mapping": true,
            "prop": "variant",
            "values": {
              "primary": "var(--bg)",
              "secondary": "var(--text)"
            }
          },
          "textDecoration": "none",
          "marginTop": {
            "_mapping": true,
            "prop": "isMarginTop",
            "values": {
              "primary": "30px",
              "secondary": "",
              "true": "30px",
              "false": "0"
            }
          },
          "borderRadius": "var(--b-br)",
          "fontWeight": "var(--b-fw)",
          "flexDirection": "row"
        },
        "tablet": {},
        "mobile": {}
      },
      "interactiveStyles": [
        {
          "name": "on hover",
          "postfix": ":hover",
          "style": {
            "base": {
              "backgroundColor": {
                "_mapping": true,
                "prop": "variant",
                "values": {
                  "primary": "var(--text-100)",
                  "secondary": "var(--bg-100)"
                }
              },
              "borderColor": {
                "_mapping": true,
                "prop": "variant",
                "values": {
                  "primary": "var(--text-100)",
                  "secondary": "var(--border-100)"
                }
              },
              "top": "0"
            }
          }
        }
      ],
      "children": [
        {
          "type": "node",
          "tag": "span",
          "label": "text",
          "style": {
            "base": {},
            "tablet": {},
            "mobile": {}
          },
          "children": "{{text}}",
          "text": "{{text}}"
        },
        {
          "type": "embed",
          "html": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>",
          "label": "arrow",
          "style": {
            "base": {
              "height": "18px"
            },
            "tablet": {},
            "mobile": {}
          }
        }
      ]
    },
    "interface": {
      "text": {
        "type": "string",
        "default": "Link"
      },
      "variant": {
        "type": "select",
        "default": "primary",
        "options": [
          "primary",
          "secondary"
        ]
      },
      "isMarginTop": {
        "type": "boolean",
        "default": false
      },
      "link": {
        "type": "link"
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    },
    "attributes": {
      "fade": "{{fade}}"
    }
  }
}