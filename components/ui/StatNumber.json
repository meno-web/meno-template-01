{
  "component": {
    "interface": {
      "text": { "type": "string", "default": "1" },
      "size": {
        "type": "select",
        "options": ["small", "medium", "large"],
        "default": "large"
      },
      "color": {
        "type": "select",
        "options": ["primary", "text"],
        "default": "primary"
      }
    },
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "fontWeight": "700",
          "lineHeight": "1",
          "marginBottom": "16px",
          "fontSize": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "32px",
              "medium": "40px",
              "large": "48px"
            }
          },
          "color": {
            "_mapping": true,
            "prop": "color",
            "values": {
              "primary": "var(--primary)",
              "text": "var(--text)"
            }
          }
        },
        "mobile": {
          "fontSize": {
            "_mapping": true,
            "prop": "size",
            "values": {
              "small": "24px",
              "medium": "32px",
              "large": "40px"
            }
          }
        }
      },
      "children": ["{{text}}"]
    }
  }
}
