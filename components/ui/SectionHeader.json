{
  "component": {
    "structure": {
      "type": "node",
      "tag": "div",
      "style": {
        "base": {
          "display": "flex",
          "flexDirection": "column",
          "alignItems": {
            "_mapping": true,
            "prop": "isCenter",
            "values": {
              "default": "flex-start",
              "true": "center",
              "false": "flex-start"
            }
          },
          "marginBottom": "80px",
          "maxWidth": "{{maxWidth}}",
          "textAlign": {
            "_mapping": true,
            "prop": "isCenter",
            "values": {
              "default": "left",
              "true": "center",
              "false": "left"
            }
          },
          "marginRight": "auto",
          "marginLeft": "auto"
        },
        "tablet": {},
        "mobile": {
          "paddingLeft": "0",
          "paddingBottom": "32px"
        }
      },
      "children": [
        {
          "type": "slot"
        }
      ],
      "attributes": {
        "fade": "{{fade}}"
      }
    },
    "interface": {
      "isCenter": {
        "type": "boolean",
        "default": false
      },
      "maxWidth": {
        "type": "string",
        "default": "100%"
      },
      "fade": {
        "type": "string",
        "default": ""
      }
    }
  }
}
