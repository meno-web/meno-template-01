{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SectionHeader",
          "props": {
            "vertical": "top",
            "horizontal": "center",
            "isCenter": true
          },
          "children": [
            {
              "type": "component",
              "component": "Subtitle",
              "props": {
                "text": "{{subtitle}}",
                "align": "center"
              }
            },
            {
              "type": "component",
              "component": "Heading",
              "props": {
                "text": "{{title}}",
                "maxWidth": "640px",
                "align": "center",
                "size": "2",
                "tag": "2"
              }
            },
            {
              "type": "component",
              "component": "Text",
              "props": {
                "text": "{{text}}",
                "size": "large",
                "align": "center",
                "maxWidth": "580px",
                "isMarginBottom": true
              }
            }
          ]
        },
        {
          "type": "component",
          "component": "ListGrid",
          "props": {
            "list": "{{list}}",
            "columns": "4"
          },
          "children": [
            {
              "type": "node",
              "tag": "div",
              "style": {
                "base": {
                  "textAlign": "center",
                  "padding": "24px"
                }
              },
              "children": [
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "fontSize": "48px",
                      "fontWeight": "700",
                      "color": "var(--text)",
                      "lineHeight": "1.2",
                      "marginBottom": "8px"
                    },
                    "mobile": {
                      "fontSize": "36px"
                    }
                  },
                  "children": "{{item.value}}"
                },
                {
                  "type": "node",
                  "tag": "div",
                  "style": {
                    "base": {
                      "fontSize": "16px",
                      "color": "var(--text-secondary)"
                    }
                  },
                  "children": "{{item.label}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "By the numbers"
      },
      "title": {
        "type": "rich-text",
        "default": "Trusted by thousands"
      },
      "text": {
        "type": "rich-text",
        "default": "Our track record speaks for itself. Here are some key metrics."
      },
      "list": {
        "type": "list",
        "itemSchema": {
          "value": {
            "type": "string",
            "default": "100+"
          },
          "label": {
            "type": "string",
            "default": "Label"
          }
        },
        "default": [
          {
            "value": "10K+",
            "label": "Happy customers"
          },
          {
            "value": "99%",
            "label": "Satisfaction rate"
          },
          {
            "value": "50M+",
            "label": "Tasks completed"
          },
          {
            "value": "24/7",
            "label": "Support available"
          }
        ]
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "options": [
          "primary",
          "secondary"
        ]
      }
    }
  }
}