{
  "component": {
    "structure": {
      "type": "component",
      "component": "Section",
      "props": {
        "theme": "{{theme}}",
        "spaceTop": "default"
      },
      "children": [
        {
          "type": "component",
          "component": "SplitContent",
          "children": [
            {
              "type": "component",
              "component": "Stack",
              "props": {
                "vertical": "center",
                "horizontal": "left"
              },
              "children": [
                {
                  "type": "component",
                  "component": "Subtitle",
                  "props": {
                    "text": "{{subtitle}}",
                    "align": "left"
                  }
                },
                {
                  "type": "component",
                  "component": "Heading",
                  "props": {
                    "text": "{{title}}",
                    "maxWidth": "100%",
                    "align": "left",
                    "size": "2",
                    "tag": "2"
                  }
                },
                {
                  "type": "component",
                  "component": "Text",
                  "props": {
                    "text": "{{text}}",
                    "size": "large",
                    "align": "left",
                    "maxWidth": "100%"
                  }
                }
              ]
            },
            {
              "type": "component",
              "component": "Image",
              "props": {
                "image": "{{image}}",
                "rounded": "large"
              }
            }
          ]
        }
      ]
    },
    "interface": {
      "subtitle": {
        "type": "string",
        "default": "Feature"
      },
      "title": {
        "type": "rich-text",
        "default": "Powerful feature that makes a difference"
      },
      "text": {
        "type": "rich-text",
        "default": "This feature helps you accomplish your goals faster and more efficiently than ever before."
      },
      "image": {
        "type": "file",
        "accept": "image/*",
        "default": "/images/placeholder.webp"
      },
      "theme": {
        "type": "select",
        "default": "primary",
        "options": ["primary", "secondary"]
      }
    }
  }
}
