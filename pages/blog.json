{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Section",
        "props": {
          "theme": "primary"
        },
        "children": [
          {
            "type": "component",
            "component": "Heading",
            "props": {
              "text": "Blog",
              "size": "1",
              "tag": "1"
            }
          },
          {
            "type": "component",
            "component": "Spacer",
            "props": {
              "size": "48"
            }
          },
          {
            "type": "list",
            "sourceType": "collection",
            "source": "posts",
            "itemAs": "post",
            "sort": {
              "field": "publishedAt",
              "direction": "desc"
            },
            "children": [
              {
                "type": "node",
                "tag": "a",
                "style": {
                  "base": {
                    "display": "grid",
                    "gridTemplateColumns": "400px 1fr",
                    "gap": "32px",
                    "alignItems": "start",
                    "paddingTop": "32px",
                    "paddingBottom": "32px",
                    "borderBottom": "1px solid var(--border-light)",
                    "textDecoration": "none",
                    "color": "inherit"
                  },
                  "tablet": {
                    "gridTemplateColumns": "200px 1fr",
                    "gap": "24px"
                  },
                  "mobile": {
                    "gridTemplateColumns": "1fr",
                    "gap": "16px"
                  }
                },
                "interactiveStyles": [
                  {
                    "postfix": ":hover h2",
                    "style": {
                      "base": {
                        "color": "var(--primary)"
                      }
                    }
                  }
                ],
                "attributes": {
                  "href": "/blog/{{post.slug}}"
                },
                "children": [
                  {
                    "type": "component",
                    "component": "Image",
                    "props": {
                      "image": "{{post.featuredImage}}",
                      "alt": "{{post.title}}",
                      "objectFit": "cover",
                      "height": "100%",
                      "border": true,
                      "rounded": "medium"
                    }
                  },
                  {
                    "type": "node",
                    "tag": "div",
                    "style": {
                      "base": {
                        "display": "flex",
                        "flexDirection": "column"
                      },
                      "tablet": {},
                      "mobile": {}
                    },
                    "children": [
                      {
                        "type": "component",
                        "component": "Text",
                        "props": {
                          "text": "{{post.publishedAt}}",
                          "size": "small",
                          "variant": "light"
                        }
                      },
                      {
                        "type": "component",
                        "component": "Spacer",
                        "props": {
                          "size": "8"
                        }
                      },
                      {
                        "type": "component",
                        "component": "Heading",
                        "props": {
                          "text": "{{post.title}}",
                          "tag": "2",
                          "size": "4"
                        }
                      },
                      {
                        "type": "component",
                        "component": "Text",
                        "props": {
                          "text": "{{post.excerpt}}",
                          "variant": "light",
                          "size": "default"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "meta": {
    "title": "Blog",
    "description": "Latest articles and updates"
  }
}