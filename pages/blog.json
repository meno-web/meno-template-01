{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Section",
        "props": {
          "theme": "primary"
        },
        "children": [
          {
            "type": "component",
            "component": "Heading",
            "props": {
              "text": "Blog",
              "size": "1",
              "tag": "1"
            }
          },
          {
            "type": "component",
            "component": "Spacer",
            "props": {
              "size": "48"
            }
          },
          {
            "type": "cms-list",
            "collection": "posts",
            "itemAs": "post",
            "sort": {
              "field": "publishedAt",
              "direction": "desc"
            },
            "children": [
              {
                "type": "component",
                "component": "BlogCard",
                "props": {
                  "href": "/blog/{{post.slug}}",
                  "image": "{{post.featuredImage}}",
                  "title": "{{post.title}}",
                  "date": "{{post.publishedAt}}",
                  "excerpt": "{{post.excerpt}}"
                },
                "href": "/blog/{{post.slug}}"
              }
            ]
          }
        ]
      }
    ]
  },
  "meta": {
    "title": "Blog",
    "description": "Latest articles and updates"
  }
}