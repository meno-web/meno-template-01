{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Section",
        "props": {
          "theme": "primary",
          "spaceTop": "large"
        },
        "children": [
          {
            "type": "component",
            "component": "Stack",
            "props": {
              "vertical": "center",
              "horizontal": "center"
            },
            "children": [
              {
                "type": "node",
                "tag": "span",
                "style": {
                  "base": {
                    "fontSize": "120px",
                    "fontWeight": "700",
                    "lineHeight": "1",
                    "color": "var(--primary)",
                    "marginBottom": "24px"
                  },
                  "mobile": {
                    "fontSize": "80px"
                  }
                },
                "children": "404"
              },
              {
                "type": "component",
                "component": "Heading",
                "props": {
                  "text": {
                    "_i18n": true,
                    "en": "Page not found",
                    "pl": "Nie znaleziono strony"
                  },
                  "size": "2",
                  "tag": "1",
                  "align": "center"
                }
              },
              {
                "type": "component",
                "component": "Text",
                "props": {
                  "text": {
                    "_i18n": true,
                    "en": "The page you're looking for doesn't exist or has been moved.",
                    "pl": "Strona, której szukasz, nie istnieje lub została przeniesiona."
                  },
                  "align": "center",
                  "maxWidth": "400px",
                  "isMarginBottom": true
                }
              },
              {
                "type": "component",
                "component": "Button",
                "props": {
                  "text": {
                    "_i18n": true,
                    "en": "Back to Home",
                    "pl": "Wróć na stronę główną"
                  },
                  "variant": "primary",
                  "isMarginTop": true,
                  "link": {
                    "href": "/"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "meta": {
    "title": {
      "_i18n": true,
      "en": "Page Not Found - Meno Studio",
      "pl": "Nie znaleziono strony - Meno Studio"
    }
  }
}
