{
  "root": {
    "type": "component",
    "component": "Layout",
    "children": [
      {
        "type": "component",
        "component": "Section",
        "props": {
          "theme": "primary",
          "spaceTop": "small"
        },
        "children": [
          {
            "type": "component",
            "component": "Stack",
            "props": {
              "horizontal": "center"
            },
            "children": [
              {
                "type": "component",
                "component": "Heading",
                "props": {
                  "text": "Contact us",
                  "size": "1",
                  "tag": "1",
                  "align": "center",
                  "maxWidth": "800px"
                }
              },
              {
                "type": "component",
                "component": "Text",
                "props": {
                  "text": "Have questions about Meno Studio? Our team is here to help you find the perfect plan for your needs.",
                  "size": "large",
                  "align": "center",
                  "maxWidth": "520px",
                  "isMarginBottom": true
                }
              }
            ]
          }
        ]
      },
      {
        "type": "component",
        "component": "Section",
        "props": {
          "theme": "secondary",
          "maxWidth": "640",
          "spaceTop": "default"
        },
        "children": [
          {
            "type": "component",
            "component": "Form",
            "props": {
              "action": "/api/send-email",
              "method": "post",
              "submitHandler": "fetch",
              "successMessage": "Thank you! Our sales team will contact you soon.",
              "errorMessage": "Something went wrong. Please try again."
            },
            "children": [
              {
                "type": "component",
                "component": "FormField",
                "children": [
                  {
                    "type": "component",
                    "component": "Label",
                    "props": {
                      "text": "Full Name"
                    }
                  },
                  {
                    "type": "component",
                    "component": "Input",
                    "props": {
                      "inputType": "text",
                      "name": "fullName",
                      "placeholder": "Your full name"
                    }
                  }
                ]
              },
              {
                "type": "component",
                "component": "FormField",
                "children": [
                  {
                    "type": "component",
                    "component": "Label",
                    "props": {
                      "text": "Email Address"
                    }
                  },
                  {
                    "type": "component",
                    "component": "Input",
                    "props": {
                      "inputType": "email",
                      "name": "email",
                      "placeholder": "you@company.com"
                    }
                  }
                ]
              },
              {
                "type": "component",
                "component": "FormField",
                "children": [
                  {
                    "type": "component",
                    "component": "Label",
                    "props": {
                      "text": "Company Name"
                    }
                  },
                  {
                    "type": "component",
                    "component": "Input",
                    "props": {
                      "inputType": "text",
                      "name": "company",
                      "placeholder": "Your company"
                    }
                  }
                ]
              },
              {
                "type": "component",
                "component": "FormField",
                "children": [
                  {
                    "type": "component",
                    "component": "Label",
                    "props": {
                      "text": "How can we help?"
                    }
                  },
                  {
                    "type": "component",
                    "component": "Textarea",
                    "props": {
                      "name": "message",
                      "placeholder": "Tell us about your project...",
                      "rows": "5"
                    }
                  }
                ]
              },
              {
                "type": "component",
                "component": "Submit",
                "props": {
                  "text": "Send Message"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "meta": {
    "title": "Contact Sales - Meno Studio",
    "description": "Get in touch with our sales team to learn more about Meno Studio for your enterprise."
  }
}